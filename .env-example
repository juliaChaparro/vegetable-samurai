# =============================================================
# .env.example — Copie este arquivo para .env e preencha os valores
# Responsável: Membro 2 | Exercício #3
# IMPORTANTE: o arquivo .env NÃO deve ser versionado (está no .gitignore)
# =============================================================

# Porta do servidor Express
PORT=3000

# Ambiente de execução
NODE_ENV=development

# URL de conexão com o banco MySQL (formato Prisma)
DATABASE_URL="mysql://usuario:senha@localhost:3306/vegetable_samurai"

# Segredo para assinatura dos cookies da Sessão do Express
SESSION_SECRET="super-secret-key-exemplo"

# Caminho para o arquivo de log do servidor
LOGS_PATH="./logs/app.log"

LOGS_PATH=./logs