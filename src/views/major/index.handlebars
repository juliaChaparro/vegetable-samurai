{{!-- major/index.handlebars — Exercício #13 e #14 | Membro 2 --}}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📚 Cursos Cadastrados</h2>
        <a href="/major/create" class="btn btn-success">+ Novo Curso</a>
    </div>

    {{#if majors.length}}
    <table class="table table-hover table-bordered align-middle">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Sigla</th>
                <th>Descrição</th>
                <th class="text-center" style="width:160px">Ações</th>
            </tr>
        </thead>
        <tbody>
            {{#each majors}}
            <tr>
                <td>{{this.name}}</td>
                <td><span class="badge bg-secondary">{{this.code}}</span></td>
                <td>{{this.description}}</td>
                <td class="text-center">
                    <a href="/major/{{this.id}}/edit" class="btn btn-sm btn-warning me-1">
                        ✏️ Editar
                    </a>
                    <button type="button" class="btn btn-sm btn-danger" 
                            data-bs-toggle="modal" 
                            data-bs-target="#modalDeletar-{{this.id}}">
                        🗑️ Excluir
                    </button>

                    {{!-- Modal de confirmação para cada item --}}
                    <div class="modal fade" id="modalDeletar-{{this.id}}" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content">
                                <div class="modal-header bg-danger text-white">
                                    <h5 class="modal-title">⚠️ Confirmar Exclusão</h5>
                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body text-start">
                                    Tem certeza que deseja excluir o curso <strong>{{this.name}}</strong>?
                                    <br><small class="text-muted">Esta ação não pode ser desfeita.</small>
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Não, cancelar</button>
                                    <button onclick="deletarMajor('{{this.id}}')" type="button" class="btn btn-danger">Sim, apagar curso</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
    {{else}}
    <div class="alert alert-info">
        Nenhum curso cadastrado ainda.
        <a href="/major/create">Cadastre o primeiro!</a>
    </div>
    {{/if}}
</div>

<script src="/js/script.js"></script>
