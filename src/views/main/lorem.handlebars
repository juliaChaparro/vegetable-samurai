<div class="py-5">
  <div class="d-flex justify-content-between align-items-center border-bottom pb-3 mb-4">
    <h1 class="h2 text-primary mb-0">
      {{title}}
    </h1>
    <span class="badge bg-primary fs-6 px-3 py-2 rounded-pill">
      {{paragraphs.length}} Parágrafos
    </span>
  </div>

  <div class="card border-0 shadow-sm mb-4 bg-light">
    <div class="card-body p-4 p-md-5 rounded">
      {{#each paragraphs}}
        <p class="mb-4 text-dark lh-lg fs-5 text-justify" style="text-indent: 2rem;">
          {{this}}
        </p>
      {{/each}}
    </div>
  </div>

  <div class="text-center mt-4">
    <p class="text-muted mb-2">Experimente gerar outras quantidades:</p>
    <div class="d-inline-flex gap-2 justify-content-center flex-wrap">
      <a href="/lorem/3" class="btn btn-outline-secondary px-3 py-2">Gerar 3</a>
      <a href="/lorem/5" class="btn btn-outline-secondary px-3 py-2">Gerar 5</a>
      <a href="/lorem/14" class="btn btn-outline-primary px-3 py-2">Gerar 14 (Exemplo)</a>
      <a href="/lorem/20" class="btn btn-outline-secondary px-3 py-2">Gerar 20</a>
    </div>
  </div>
</div>
